# Copy to `.env` for local dev (`npm start`). In production the two secrets are
# SSM Parameter Store SecureStrings under /latent-inference/ (see README), and
# the models and caps are set in infra/lib/site-stack.ts.
# NEVER commit the real key. `.env` is gitignored.

# Anthropic API key used ONLY server-side (chat, daily news ranking, and the
# weekday briefing).
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model IDs (overridable). Chat + news ranking both use Haiku by default.
CHAT_MODEL=claude-haiku-4-5
NEWS_MODEL=claude-haiku-4-5
# The Agentic AI Intelligence Briefing (one call per weekday) uses Sonnet.
BRIEFING_MODEL=claude-sonnet-5-5

# Cost guardrail: max chat messages per client IP per UTC day, and site-wide.
CHAT_DAILY_CAP=100
CHAT_GLOBAL_DAILY_CAP=300

# Max characters accepted in a single user chat message.
CHAT_MAX_INPUT_CHARS=4000

# Secret that enables the on-demand news refresh at /api/refresh-news?key=...
# Leave blank to disable that endpoint. Use a long random string in production.
NEWS_REFRESH_KEY=
