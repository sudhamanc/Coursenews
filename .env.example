# Copy to `.env` for local dev (netlify dev), and set the real values in the
# Netlify UI under Site configuration > Environment variables (Functions scope).
# NEVER commit the real key. `.env` is gitignored.

# Anthropic API key used ONLY by Netlify Functions (chat + daily news ranking).
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Model IDs (overridable). Chat + news ranking both use Haiku by default.
CHAT_MODEL=claude-haiku-4-5
NEWS_MODEL=claude-haiku-4-5

# Cost guardrail: max chat messages per client IP per UTC day.
CHAT_DAILY_CAP=100

# Max characters accepted in a single user chat message.
CHAT_MAX_INPUT_CHARS=4000

# Secret that enables the on-demand news refresh at /api/refresh-news?key=...
# Leave blank to disable that endpoint. Use a long random string in production.
NEWS_REFRESH_KEY=
