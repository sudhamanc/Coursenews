---
import Newspaper from '../layouts/Newspaper.astro';
---

<Newspaper
  section="latest"
  title="Latest in AI — Latent Inference"
  description="An Agentic AI Intelligence Briefing on enterprise adoption, a daily ranked digest of AI research from arXiv and Hacker News, and an ecosystem wire tracking model releases, protocol versions, libraries, and architectural patterns. Thirty days of past editions."
>
  <nav class="edition-bar" id="edition-bar" aria-label="Edition" hidden>
    <a class="edition-bar__step" id="ed-older" rel="prev">‹ Older</a>
    <label class="edition-bar__pick">
      <span>Edition</span>
      <select id="ed-select"></select>
    </label>
    <a class="edition-bar__step" id="ed-newer" rel="next">Newer ›</a>
    <a class="edition-bar__today" id="ed-today" href="?" hidden>Today’s edition</a>
  </nav>
  <p class="edition-note" id="ed-note" hidden></p>

  <section>
    <span class="flag">The Briefing</span>
    <h2 class="headline headline--xl">Agentic AI Intelligence Briefing</h2>
    <p class="brief__standfirst">How enterprises are putting AI agents to work — and how their software, infrastructure, and commerce are changing around them.</p>

    <hr class="rule rule--heavy" />

    <p id="brief-loading" class="u-muted">Loading the briefing…</p>
    <p id="brief-empty" class="u-muted" hidden>
      No briefing has been published yet. Briefings appear on weekday mornings
      (US time).
    </p>

    <div class="brief" id="brief" hidden>
      <p class="brief__dateline">
        <span id="brief-date"></span>
        <span class="brief__sep" aria-hidden="true">|</span>
        <span id="brief-since"></span>
      </p>
      <p class="brief__note" id="brief-note" hidden></p>
      <p class="brief__headline"><span class="brief__kicker" id="brief-kicker">Today’s headline:</span> <span id="brief-headline"></span></p>
      <p class="brief__lede" id="brief-lede"></p>
      <ol class="brief__devs" id="brief-devs"></ol>
      <div class="brief__also" id="brief-also-wrap" hidden>
        <h3 class="eco-group__title">Also on the radar</h3>
        <ul class="brief__also-list" id="brief-also"></ul>
      </div>
    </div>
  </section>

  <section class="u-mt">
    <span class="flag">The Wire</span>
    <h2 class="headline headline--xl">Latest in AI</h2>

    <hr class="rule rule--heavy" />

    <p id="news-loading" class="u-muted">Loading the latest…</p>
    <p id="news-empty" class="u-muted" hidden>
      The wire hasn’t been populated yet. Once the daily refresh runs, ranked
      stories will appear here.
    </p>

    <ol class="news" id="news-list"></ol>
    <div class="u-center u-mt">
      <button type="button" class="dig-deeper" id="news-more" hidden>Show more stories</button>
    </div>
  </section>

  <section class="u-mt">
    <span class="flag">The Ecosystem</span>
    <h2 class="headline headline--xl">What Shipped</h2>

    <hr class="rule rule--heavy" />

    <p id="eco-loading" class="u-muted">Loading the ecosystem…</p>
    <p id="eco-empty" class="u-muted" hidden>
      The ecosystem wire hasn’t been populated yet. Once the daily refresh runs,
      releases and launches will appear here.
    </p>

    <div id="eco-groups"></div>
  </section>
</Newspaper>

<script>
  import { editionDate, formatDay } from '../lib/edition';

  // The edition picker. Each choice is a plain navigation to ?date=…, so every
  // edition has a shareable URL and the page itself stays static.
  const bar = document.getElementById('edition-bar')!;
  const select = document.getElementById('ed-select') as HTMLSelectElement;
  const older = document.getElementById('ed-older') as HTMLAnchorElement;
  const newer = document.getElementById('ed-newer') as HTMLAnchorElement;
  const today = document.getElementById('ed-today') as HTMLAnchorElement;
  const note = document.getElementById('ed-note')!;

  const hrefFor = (date: string | null) => (date ? `?date=${date}` : window.location.pathname);

  function step(link: HTMLAnchorElement, date: string | null | undefined, isLatest = false) {
    if (date === undefined) {
      link.removeAttribute('href');
      link.setAttribute('aria-disabled', 'true');
    } else {
      link.href = hrefFor(isLatest ? null : date);
      link.removeAttribute('aria-disabled');
    }
  }

  async function loadEditions() {
    try {
      const res = await fetch('/api/editions');
      if (!res.ok) return;
      const dates: string[] = ((await res.json()).editions ?? []).map((e: { date: string }) => e.date);
      const asked = editionDate();
      // Nothing to pick between until a second day is archived. A dated link
      // still gets the bar, so its "Today's edition" link can lead back.
      if (dates.length === 0 || (dates.length === 1 && !asked)) return;

      const latest = dates[0];
      const current = asked && dates.includes(asked) ? asked : asked ?? latest;
      const i = dates.indexOf(current);

      for (const d of dates) {
        const opt = document.createElement('option');
        opt.value = d;
        opt.textContent = d === latest ? `${formatDay(d, 'short')} (latest)` : formatDay(d, 'short');
        opt.selected = d === current;
        select.appendChild(opt);
      }
      select.addEventListener('change', () => {
        window.location.href = hrefFor(select.value === latest ? null : select.value);
      });

      // Newest first: "older" is the next index, "newer" the previous one.
      step(older, i >= 0 ? dates[i + 1] : undefined);
      step(newer, i > 0 ? dates[i - 1] : undefined, i === 1);

      if (asked && asked !== latest) {
        today.hidden = false;
        today.href = window.location.pathname;
        note.hidden = false;
        note.textContent =
          i >= 0
            ? `You are reading the archived edition for ${formatDay(asked)}.`
            : `There is no archived edition for ${formatDay(asked)}. Editions are kept for 30 days.`;
      }
      bar.hidden = false;
    } catch {
      /* the picker is optional; today's edition still renders */
    }
  }

  loadEditions();
</script>

<script>
  import { editionDate, editionQuery, formatDay, safeHref, todayUtc } from '../lib/edition';

  interface Source {
    title: string;
    url: string;
    outlet: string;
  }
  interface Briefing {
    date: string;
    since: string;
    headline: string;
    developments: Array<{ label: string; takeaway: string; implication?: string; sources: Source[] }>;
    alsoNoted: Array<Source & { note: string }>;
  }

  const $ = (id: string) => document.getElementById(id)!;
  const COUNT = ['No', 'One', 'Two', 'Three'];

  function sourceLinks(sources: Source[]): HTMLParagraphElement {
    const p = document.createElement('p');
    p.className = 'brief__src';
    sources.forEach((s, i) => {
      const href = safeHref(s.url);
      if (!href) return;
      if (p.childNodes.length) p.appendChild(document.createTextNode(' · '));
      const a = document.createElement('a');
      a.href = href;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = s.outlet || `Source ${i + 1}`;
      a.title = s.title;
      p.appendChild(a);
    });
    return p;
  }

  async function loadBriefing() {
    try {
      const res = await fetch(`/api/briefing${editionQuery()}`);
      if (!res.ok) throw new Error(String(res.status));
      const b: Briefing | null = await res.json();
      $('brief-loading').hidden = true;
      if (!b || !b.headline || !Array.isArray(b.developments)) {
        $('brief-empty').hidden = false;
        return;
      }

      $('brief-date').textContent = formatDay(b.date);
      const since = b.since
        ? new Date(b.since).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short', day: 'numeric' })
        : '';
      $('brief-since').textContent = since
        ? `Developments since the previous briefing (${since})`
        : 'Developments since the previous briefing';

      const asked = editionDate();
      if (asked && asked !== b.date) {
        const n = $('brief-note');
        n.hidden = false;
        n.textContent = `No briefing was published on ${formatDay(asked)}; this is the most recent one before it.`;
      }
      if (b.date !== todayUtc()) $('brief-kicker').textContent = 'The headline:';
      $('brief-headline').textContent = b.headline;

      const devs = b.developments;
      $('brief-lede').textContent = `${COUNT[devs.length] ?? devs.length} development${devs.length === 1 ? '' : 's'} ${devs.length === 1 ? 'deserves' : 'deserve'} particular attention:`;

      const ol = $('brief-devs');
      for (const d of devs) {
        const li = document.createElement('li');
        li.className = 'brief__dev';
        const p = document.createElement('p');
        p.className = 'brief__take';
        const strong = document.createElement('strong');
        strong.textContent = `${d.label}:`;
        p.appendChild(strong);
        p.appendChild(document.createTextNode(` ${d.takeaway}`));
        li.appendChild(p);
        if (d.implication) {
          const impl = document.createElement('p');
          impl.className = 'brief__impl';
          impl.textContent = d.implication;
          li.appendChild(impl);
        }
        li.appendChild(sourceLinks(d.sources ?? []));
        ol.appendChild(li);
      }

      const also = (b.alsoNoted ?? []).filter((a) => safeHref(a.url));
      if (also.length) {
        const ul = $('brief-also');
        for (const a of also) {
          const li = document.createElement('li');
          const link = document.createElement('a');
          link.href = safeHref(a.url)!;
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
          link.textContent = a.title;
          const meta = document.createElement('span');
          meta.className = 'brief__also-outlet';
          meta.textContent = ` — ${a.outlet}`;
          const why = document.createElement('p');
          why.className = 'news__why';
          why.textContent = a.note;
          li.append(link, meta, why);
          ul.appendChild(li);
        }
        $('brief-also-wrap').hidden = false;
      }
      $('brief').hidden = false;
    } catch {
      $('brief-loading').hidden = true;
      const e = $('brief-empty');
      e.hidden = false;
      e.textContent = 'The briefing is unavailable right now. Please try again later.';
    }
  }

  loadBriefing();
</script>

<script>
  import { editionQuery } from '../lib/edition';

  interface NewsItem {
    id: string;
    title: string;
    url: string;
    source: string;
    published: string;
    points?: number;
    authors?: string;
    category?: string;
    why?: string;
  }

  // Default view is the ranker's top 5; the rest stay behind the toggle.
  const TOP = 5;
  const list = document.getElementById('news-list') as HTMLOListElement;
  const loading = document.getElementById('news-loading')!;
  const empty = document.getElementById('news-empty')!;
  const moreBtn = document.getElementById('news-more') as HTMLButtonElement;

  const safeHref = (url: string): string | null => {
    try {
      const u = new URL(url);
      return u.protocol === 'http:' || u.protocol === 'https:' ? u.href : null;
    } catch {
      return null;
    }
  };

  function renderItem(item: NewsItem, rank: number): HTMLLIElement | null {
    const href = safeHref(item.url);
    if (!href) return null;

    const li = document.createElement('li');
    li.className = 'news__item';

    const rankEl = document.createElement('span');
    rankEl.className = 'news__rank';
    rankEl.textContent = String(rank);

    const main = document.createElement('div');

    const meta = document.createElement('div');
    meta.className = 'news__meta';
    const badge = document.createElement('span');
    badge.className = 'news__source';
    badge.textContent = item.source;
    meta.appendChild(badge);
    if (item.category) {
      const cat = document.createElement('span');
      cat.className = 'news__cat';
      cat.textContent = item.category;
      meta.appendChild(cat);
    }
    if (typeof item.points === 'number') {
      const pts = document.createElement('span');
      pts.className = 'u-muted';
      pts.textContent = `${item.points} points`;
      meta.appendChild(pts);
    }

    const h = document.createElement('h3');
    h.className = 'headline headline--sm news__title';
    const a = document.createElement('a');
    a.href = href;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.textContent = item.title;
    h.appendChild(a);

    main.appendChild(meta);
    main.appendChild(h);

    if (item.why) {
      const why = document.createElement('p');
      why.className = 'news__why';
      why.textContent = item.why;
      main.appendChild(why);
    }

    const foot = document.createElement('p');
    foot.className = 'news__foot u-muted';
    const when = new Date(item.published).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
    foot.textContent = item.authors ? `${item.authors} · ${when}` : when;
    main.appendChild(foot);

    li.appendChild(rankEl);
    li.appendChild(main);
    return li;
  }

  async function load() {
    try {
      const res = await fetch(`/api/news${editionQuery()}`);
      if (!res.ok) throw new Error(String(res.status));
      const feed = await res.json();
      const items: NewsItem[] = Array.isArray(feed.items) ? feed.items : [];
      loading.hidden = true;

      if (items.length === 0) {
        empty.hidden = false;
        return;
      }

      let rank = 0;
      const nodes = items
        .map((it) => renderItem(it, ++rank))
        .filter((n): n is HTMLLIElement => n !== null);

      nodes.forEach((n, i) => {
        if (i >= TOP) n.classList.add('news__item--hidden');
        list.appendChild(n);
      });

      if (nodes.length > TOP) {
        moreBtn.hidden = false;
        moreBtn.addEventListener('click', () => {
          list.querySelectorAll('.news__item--hidden').forEach((n) => n.classList.remove('news__item--hidden'));
          moreBtn.hidden = true;
        });
      }
    } catch {
      loading.hidden = true;
      empty.hidden = false;
      empty.textContent = 'The wire is unavailable right now. Please try again later.';
    }
  }

  load();
</script>

<script>
  import { editionQuery } from '../lib/edition';

  interface EcoItem {
    id: string;
    title: string;
    url: string;
    source: string;
    lane: 'tracked' | 'discovered';
    published: string;
    version?: string;
    bucket?: string;
    why?: string;
    points?: number;
  }

  // Fixed display order; the ranker is constrained to these four buckets.
  const BUCKETS: Array<[string, string]> = [
    ['Models', 'Models & Weights'],
    ['Standards', 'Standards & Protocols'],
    ['Libraries', 'Libraries & SDKs'],
    ['Patterns', 'Patterns & Architecture'],
  ];
  // Five per bucket, filled by alternating the two lanes' ranked orders rather
  // than concatenating them. A flat cap let Show HN fill every Libraries slot and
  // pushed the actual version releases out of view; concatenating fixed that but
  // buried the ranking. Alternating keeps each lane in LLM-ranked order AND
  // guarantees both are represented, with the dated releases leading.
  const PER_BUCKET = 5;

  function interleave(tracked: EcoItem[], discovered: EcoItem[], n: number): EcoItem[] {
    const out: EcoItem[] = [];
    for (let i = 0; out.length < n && (i < tracked.length || i < discovered.length); i++) {
      if (i < tracked.length && out.length < n) out.push(tracked[i]);
      if (i < discovered.length && out.length < n) out.push(discovered[i]);
    }
    return out;
  }

  const groups = document.getElementById('eco-groups')!;
  const ecoLoading = document.getElementById('eco-loading')!;
  const ecoEmpty = document.getElementById('eco-empty')!;

  const httpHref = (url: string): string | null => {
    try {
      const u = new URL(url);
      return u.protocol === 'http:' || u.protocol === 'https:' ? u.href : null;
    } catch {
      return null;
    }
  };

  const chip = (cls: string, text: string): HTMLSpanElement => {
    const el = document.createElement('span');
    el.className = cls;
    el.textContent = text; // textContent throughout — no innerHTML sink
    return el;
  };

  function renderEcoItem(item: EcoItem): HTMLLIElement | null {
    const href = httpHref(item.url);
    if (!href) return null;

    const li = document.createElement('li');
    li.className = 'news__item';
    const main = document.createElement('div');

    const meta = document.createElement('div');
    meta.className = 'news__meta';
    meta.appendChild(chip('news__source', item.source));
    meta.appendChild(
      chip(
        `news__lane news__lane--${item.lane}`,
        item.lane === 'tracked' ? 'Tracked' : 'New',
      ),
    );
    if (item.version) meta.appendChild(chip('news__version', item.version));
    if (typeof item.points === 'number') meta.appendChild(chip('u-muted', `${item.points} points`));

    const h = document.createElement('h3');
    h.className = 'headline headline--sm news__title';
    const a = document.createElement('a');
    a.href = href;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.textContent = item.title;
    h.appendChild(a);

    main.appendChild(meta);
    main.appendChild(h);

    if (item.why) {
      const why = document.createElement('p');
      why.className = 'news__why';
      why.textContent = item.why;
      main.appendChild(why);
    }

    const foot = document.createElement('p');
    foot.className = 'news__foot u-muted';
    foot.textContent = new Date(item.published).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    });
    main.appendChild(foot);

    li.appendChild(main);
    return li;
  }

  async function loadEcosystem() {
    try {
      const res = await fetch(`/api/ecosystem${editionQuery()}`);
      if (!res.ok) throw new Error(String(res.status));
      const feed = await res.json();
      const items: EcoItem[] = Array.isArray(feed.items) ? feed.items : [];
      ecoLoading.hidden = true;

      if (items.length === 0) {
        ecoEmpty.hidden = false;
        return;
      }
      let rendered = 0;
      for (const [key, label] of BUCKETS) {
        const ofBucket = items.filter((i) => i.bucket === key);
        const inBucket = interleave(
          ofBucket.filter((i) => i.lane === 'tracked'),
          ofBucket.filter((i) => i.lane === 'discovered'),
          PER_BUCKET,
        );
        if (inBucket.length === 0) continue;

        const section = document.createElement('div');
        section.className = 'eco-group';

        const head = document.createElement('div');
        head.className = 'eco-group__head';
        const title = document.createElement('h3');
        title.className = 'eco-group__title';
        title.textContent = label;
        head.appendChild(title);
        head.appendChild(chip('eco-group__count', `${inBucket.length}`));
        section.appendChild(head);

        const ol = document.createElement('ol');
        ol.className = 'news eco';
        for (const it of inBucket) {
          const node = renderEcoItem(it);
          if (node) {
            ol.appendChild(node);
            rendered++;
          }
        }
        section.appendChild(ol);
        groups.appendChild(section);
      }

      if (rendered === 0) ecoEmpty.hidden = false;
    } catch {
      ecoLoading.hidden = true;
      ecoEmpty.hidden = false;
      ecoEmpty.textContent = 'The ecosystem wire is unavailable right now. Please try again later.';
    }
  }

  loadEcosystem();
</script>
