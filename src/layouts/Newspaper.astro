---
import '../styles/newspaper.css';
import 'katex/dist/katex.min.css';
import { COURSES } from '../lib/courses';

export interface Props {
  title?: string;
  description?: string;
  /** Section flag shown in nav highlight, e.g. a course slug or "latest". */
  section?: string;
}

const {
  title = 'The Course Ledger',
  description = 'A newspaper of the AI, machine-learning, and data-science concepts from my graduate coursework — explained in depth.',
  section,
} = Astro.props;

/** Absolute URL for this page — canonical + Open Graph. `Astro.site` comes from
 *  astro.config.mjs, which reads Netlify's build-time URL env var. */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const now = new Date();
const dateLine = now.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover pairs with the env(safe-area-inset-*) padding in
         newspaper.css; neither is useful alone. interactive-widget lets the
         Chromium virtual keyboard resize the layout instead of covering it. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />

    <!-- Must precede the pre-paint script below, which rewrites its content. -->
    <meta id="theme-color-meta" name="theme-color" content="#fff1e5" />

    <script is:inline>
      // Set the theme before first paint to avoid a flash of the wrong colors.
      // Defaults to the FT-style light theme unless the visitor chose dark.
      (function () {
        var theme = 'light';
        try {
          theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
        } catch (e) {
          /* storage blocked — keep the default */
        }
        document.documentElement.setAttribute('data-theme', theme);
        // Colour the browser/PWA chrome to match. The values are hardcoded on
        // purpose: this runs in <head>, where the stylesheet may not have been
        // applied yet, so reading --paper via getComputedStyle can come back
        // empty. Keep them in sync with --paper in src/styles/newspaper.css.
        var m = document.getElementById('theme-color-meta');
        if (m) m.setAttribute('content', theme === 'dark' ? '#16150f' : '#fff1e5');
      })();
    </script>

    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- iOS reads these rather than the manifest for home-screen installs. -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Ledger" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Course Ledger" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="paper">
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Switch between light and dark theme"
        aria-pressed="false"
      >
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.5 6.5 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <header class="masthead">
        <div class="masthead__kicker">Vol. I · Graduate Studies · Artificial Intelligence Desk</div>
        <h1 class="masthead__title"><a href="/" style="color:inherit;border:none;">The Course Ledger</a></h1>
        <div class="masthead__dateline">
          <span>{dateLine}</span>
          <span>Concepts, Explained</span>
          <span>Price: Your Curiosity</span>
        </div>
      </header>

      <nav class="topnav" aria-label="Sections">
        <a href="/" aria-current={section === 'home' ? 'page' : undefined}>Front Page</a>
        {
          COURSES.map((c) => (
            <a
              href={`/courses/${c.slug}`}
              aria-current={section === c.slug ? 'page' : undefined}
            >
              {c.shortTitle}
            </a>
          ))
        }
        <a href="/latest" aria-current={section === 'latest' ? 'page' : undefined}>Latest in AI</a>
      </nav>
      <hr class="rule rule--heavy" />

      <main>
        <slot />
      </main>

      <footer class="footer">
        <p>The Course Ledger — the ideas behind modern AI, explained in depth.</p>
      </footer>
    </div>

    <script is:inline>
      // Theme toggle: flip data-theme on <html> and remember the choice.
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var meta = document.getElementById('theme-color-meta');
        function sync() {
          var dark = root.getAttribute('data-theme') === 'dark';
          btn.setAttribute('aria-pressed', String(dark));
          // Keep the browser/PWA chrome colour with the theme. The <meta media>
          // pattern can't be used here: the theme is localStorage-driven, not
          // prefers-color-scheme. Values mirror --paper in newspaper.css.
          if (meta) meta.setAttribute('content', dark ? '#16150f' : '#fff1e5');
        }
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          sync();
        });
        sync();
      })();

      // On narrow screens .topnav is a horizontal scroll strip, so the current
      // section can start off-screen. Bring it into view without scrolling the
      // page itself (`block: 'nearest'`).
      (function () {
        var current = document.querySelector('.topnav [aria-current="page"]');
        if (!current) return;
        var strip = current.parentElement;
        if (strip.scrollWidth > strip.clientWidth) {
          current.scrollIntoView({ inline: 'center', block: 'nearest' });
        }
      })();
    </script>
  </body>
</html>
