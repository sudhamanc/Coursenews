---
import '../styles/newspaper.css';
import 'katex/dist/katex.min.css';
import { COURSES, COURSE_BY_SLUG, GROUPS, sectionsInGroup } from '../lib/courses';

export interface Props {
  title?: string;
  description?: string;
  /** Section flag shown in nav highlight, e.g. a section slug or "latest". */
  section?: string;
}

const {
  title = 'Latent Inference',
  description = 'In-depth explainers on the ideas behind modern AI and machine learning, with an assistant in the margin.',
  section,
} = Astro.props;

/** Absolute URL for this page — canonical + Open Graph. `Astro.site` comes from
 *  astro.config.mjs, which reads Netlify's build-time URL env var. */
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Build-time fallback only; the inline script below swaps in the reader's date.
const now = new Date();
const dateLine = now.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const dateAttr = now.toISOString().slice(0, 10);

// Nav: grouped sections become pull-downs; ungrouped ones get their own link.
const currentGroup = section ? COURSE_BY_SLUG[section]?.group : undefined;
const topLevelSections = COURSES.filter((c) => !c.group);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover pairs with the env(safe-area-inset-*) padding in
         newspaper.css; neither is useful alone. interactive-widget lets the
         Chromium virtual keyboard resize the layout instead of covering it. -->
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />

    <!-- Must precede the pre-paint script below, which rewrites its content. -->
    <meta id="theme-color-meta" name="theme-color" content="#fff1e5" />

    <script is:inline>
      // Set the theme before first paint to avoid a flash of the wrong colors.
      // Defaults to the FT-style light theme unless the visitor chose dark.
      (function () {
        var theme = 'light';
        try {
          theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
        } catch (e) {
          /* storage blocked — keep the default */
        }
        document.documentElement.setAttribute('data-theme', theme);
        // Colour the browser/PWA chrome to match. The values are hardcoded on
        // purpose: this runs in <head>, where the stylesheet may not have been
        // applied yet, so reading --paper via getComputedStyle can come back
        // empty. Keep them in sync with --paper in src/styles/newspaper.css.
        var m = document.getElementById('theme-color-meta');
        if (m) m.setAttribute('content', theme === 'dark' ? '#16150f' : '#fff1e5');
      })();
    </script>

    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- iOS reads these rather than the manifest for home-screen installs. -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Latent" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Latent Inference" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="paper">
      <button
        id="theme-toggle"
        class="theme-toggle"
        type="button"
        aria-label="Switch between light and dark theme"
        aria-pressed="false"
      >
        <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.5 6.5 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <header class="masthead">
        <time class="masthead__date" data-today datetime={dateAttr}>{dateLine}</time>
        <h1 class="masthead__title"><a href="/" style="color:inherit;border:none;">Latent Inference</a></h1>
      </header>
      <script is:inline>
        // The page is static, so the build-time date freezes at the last deploy.
        // Rewrite every time[data-today] with the reader's own date: here, before
        // the masthead paints, and again after the footer. The server-rendered
        // value stays as the no-JS fallback.
        (function () {
          window.__latentToday = function () {
            var d = new Date();
            var text = d.toLocaleDateString('en-US', {
              weekday: 'long',
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });
            var pad = function (n) { return (n < 10 ? '0' : '') + n; };
            var iso = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate());
            var els = document.querySelectorAll('time[data-today]');
            for (var i = 0; i < els.length; i++) {
              els[i].textContent = text;
              els[i].setAttribute('datetime', iso);
            }
          };
          window.__latentToday();
        })();
      </script>

      <div class="topnav-wrap">
        <nav class="topnav" aria-label="Sections">
          <a class="topnav__link" href="/" aria-current={section === 'home' ? 'page' : undefined}>
            <span class="topnav__full">Front Page</span><span class="topnav__short">Front</span>
          </a>
          {
            GROUPS.map((g) => (
              <div class="topnav__group">
                <button
                  type="button"
                  class="topnav__trigger"
                  aria-expanded="false"
                  aria-controls={`topnav-${g.id}`}
                  aria-current={currentGroup === g.id ? 'true' : undefined}
                >
                  <span class="topnav__full">{g.label}</span>
                  <span class="topnav__short">{g.short}</span>
                  <svg class="topnav__caret" viewBox="0 0 10 6" aria-hidden="true">
                    <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                </button>
                <div class="topnav__panel" id={`topnav-${g.id}`}>
                  <div class="topnav__card">
                    <span class="topnav__panel-label">{g.label}</span>
                    <ul class="topnav__list">
                      {sectionsInGroup(g.id).map((c) => (
                        <li>
                          <a href={`/sections/${c.slug}`} aria-current={section === c.slug ? 'page' : undefined}>
                            <span class="topnav__item-title">{c.title}</span>
                            <span class="topnav__item-tagline">{c.tagline}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            ))
          }
          {
            topLevelSections.map((c) => (
              <a
                class="topnav__link"
                href={`/sections/${c.slug}`}
                aria-current={section === c.slug ? 'page' : undefined}
              >
                <span class="topnav__full">{c.shortTitle}</span>
                <span class="topnav__short">{c.navShort ?? c.shortTitle}</span>
              </a>
            ))
          }
          <a class="topnav__link" href="/latest" aria-current={section === 'latest' ? 'page' : undefined}>
            <span class="topnav__full">Latest in AI</span><span class="topnav__short">Latest</span>
          </a>
        </nav>
      </div>
      <hr class="rule rule--heavy" />

      <main>
        <slot />
      </main>

      <footer class="footer">
        <p>Latent Inference — the ideas behind modern AI, explained in depth.</p>
        <p class="footer__date"><time data-today datetime={dateAttr}>{dateLine}</time></p>
      </footer>
      <script is:inline>
        window.__latentToday && window.__latentToday();
      </script>
    </div>

    <script is:inline>
      // Theme toggle: flip data-theme on <html> and remember the choice.
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById('theme-toggle');
        if (!btn) return;
        var meta = document.getElementById('theme-color-meta');
        function sync() {
          var dark = root.getAttribute('data-theme') === 'dark';
          btn.setAttribute('aria-pressed', String(dark));
          // Keep the browser/PWA chrome colour with the theme. The <meta media>
          // pattern can't be used here: the theme is localStorage-driven, not
          // prefers-color-scheme. Values mirror --paper in newspaper.css.
          if (meta) meta.setAttribute('content', dark ? '#16150f' : '#fff1e5');
        }
        btn.addEventListener('click', function () {
          var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {}
          sync();
        });
        sync();
      })();

      // Section pull-downs (disclosure pattern). A trigger toggles its panel and
      // closes any other; Escape closes and returns focus to the trigger; a click
      // outside or focus leaving the group closes it. Hover-to-open on pointer
      // devices is CSS-only.
      (function () {
        var groups = Array.prototype.slice.call(document.querySelectorAll('.topnav__group'));
        if (!groups.length) return;

        function setOpen(group, open) {
          group.toggleAttribute('data-open', open);
          group.querySelector('.topnav__trigger').setAttribute('aria-expanded', String(open));
        }

        groups.forEach(function (group) {
          var trigger = group.querySelector('.topnav__trigger');
          trigger.addEventListener('click', function () {
            var open = !group.hasAttribute('data-open');
            groups.forEach(function (other) {
              if (other !== group) setOpen(other, false);
            });
            setOpen(group, open);
          });
          group.addEventListener('focusout', function (e) {
            if (!group.contains(e.relatedTarget)) setOpen(group, false);
          });
          group.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && group.hasAttribute('data-open')) {
              setOpen(group, false);
              trigger.focus();
            }
          });
        });

        document.addEventListener('click', function (e) {
          groups.forEach(function (group) {
            if (!group.contains(e.target)) setOpen(group, false);
          });
        });
      })();
    </script>
  </body>
</html>
